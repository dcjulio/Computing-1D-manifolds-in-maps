%% Manifold Computation, Pseudo-orbits reconstruction and Intersection points
% Purpose: Computes the 1D unstable manifold (U-manifold) for fixed point p+ 
%          of the 3D standard Henon-like map, identifies intersections points
%          with a specified plane and plots a pseudo-orbit.
% System:  StdHenon3D
% ------------------------------------------------------------------------

%% Environment Initialisation
    clear all
    close all
    addpath('./GrowFundCurv1D_functions'); % Path of the functions

%% Configuration Options
    % -- Setting the system parameters
    opts.thesystem = StdHenon3D; % Name of the class of methods
    opts.par       = struct('a', 4.2,'b', -0.3, 'xi', 0.8); % The parameter values and names as in the StdHenon3D class
    
    %--- Stop criterion
    opts.target_arc   = 2000; % Set the target arclength for the manifold computation
    opts.max_funditer = 100;  % Maximum number of iterations of the fundamental domain
    
    %--- Accuracy Parameters (Uncomment to override defaults)
    % alphamax:      Maximum allowable angle between successive tangent vectors
    % deltalphamax:  Maximum product of the angle and the step size
    % deltamin:      Minimum allowable distance between mesh points
    % deltamax:      Maximum allowable distance between mesh points
    % opts.accpar.alphamax     = 0.3;
    % opts.accpar.deltalphamax = 0.001; 
    % opts.accpar.deltamin     = 0.000001;
    % opts.accpar.deltamax     = 0.01;
    
    %--- Initial Step Configuration (Uncomment to override default)
    % Distance from the fixed point to the first fundamental domain.
    % Use a positive value for the positive branch and negative for the negative branch.
    % opts.accpar.init_step = 10^-7;


%% Computing the manifold: Wu(pplu) orientation-reversing
    % Name of the fixed point associated with the manifold. 
    % Note: This must match a name defined in the StdHenon3D class.
    opts.name_fixpoint = 'pplu'; 
    
    % Specify the type of manifold to compute ('Umanifold' or 'Smanifold')
    opts.stability = 'Umanifold';
    
    % Select the branch to compute ('pos' or 'neg'). 
    % Note: While this can be controlled by the sign of 'init_step', 
    % 'opts.branch' takes priority if both are specified.
    opts.branch = 'pos'; 
    
    % Execute the main algorithm to compute the manifold
    manif = GrowFundCurv1D(opts);

%% Computing the secondary branch
    % Use this for orientation-preserving cases to compute the other branch 
    % after the main routine has finished.
    % manif = add_branch(manif, opts, 'neg');

%% POST-PROCESSING
    %--- Computing intersection points
    % Define the half-plane angle theta in [-pi, pi] (e.g., pi/2: x=0, y>0; 0: y=0, x>0)
    angle = pi/4; 
    
    % Compute ordered intersection points and append to the manif structure
    manif     = inter_plane(manif, angle_val);
%% POST PROCESSING
%% Computing intersection points
    angle=pi/4; %the angle of the plane from [-pi, pi]. (angle=pi/2: x==0 (y>0), angle=0: y==0 (x>0))
    manif=inter_plane(manif,angle);

%% Plot
   h = manifplot(manif);

   xlim([-1.01 1.01])
   ylim([-1.01 1.01])
   zlim([-1.01 1.01])
%% Epsilon pseudo orbit

branch    = 'pos'; %what branch is intersecting the plane
idx  = manif.inter.points.(branch).idx(end); % for example, the closest mesh point to the last intersection point. It can be any index of mesh point from

orbit     = pseudo_orbit(manif, idx, branch); % computing the pseudo orbit of the intersection point

% Plotting the eps-pseudo-orbit
 hold on
 plot3(orbit.x([1,end]),orbit.y([1,end]),orbit.z([1,end]),'r.','MarkerSize',27) %epsilon orbit
 plot3(orbit.x,orbit.y,orbit.z,'ko--','LineWidth',1.2) %epsilon orbit

